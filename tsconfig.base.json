{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@dsh-plugin-edu/a2ui-protocol": ["packages/a2ui-protocol/src/index.ts"],
      "@dsh-plugin-edu/a2ui-adapter": ["packages/a2ui-adapter/src/index.ts"],
      "@dsh-plugin-edu/a2ui-renderer": ["packages/a2ui-renderer/src/index.ts"],
      "@dsh-plugin-edu/a2ui-renderer/client": ["packages/a2ui-renderer/src/client/api.ts"]
    },
    "types": []
  },
  "include": ["packages/**/src/**/*.ts", "packages/**/src/**/*.tsx"]
}
