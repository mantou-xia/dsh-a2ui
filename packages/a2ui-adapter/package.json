{
  "name": "@dsh-a2ui/a2ui-adapter",
  "version": "0.1.0",
  "description": "A2UI host-side plugin for dsh: registers the a2ui_render tool (model authors an A2UI document, tool persists it to tool/result.meta) and injects the A2UI teaching section",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5"
  },
  "devDependencies": {
    "@dsh-a2ui/a2ui-protocol": "link:../a2ui-protocol",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "typescript": "^5.5.0"
  }
}
