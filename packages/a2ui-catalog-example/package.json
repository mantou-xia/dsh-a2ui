{
  "name": "@dsh-a2ui/a2ui-catalog-example",
  "version": "0.1.0",
  "private": true,
  "description": "Example hot-pluggable A2UI catalog library",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client.tsx",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@dsh-a2ui/a2ui-renderer"],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5",
    "@dsh-a2ui/a2ui-adapter": "^0.1.0",
    "@dsh-a2ui/a2ui-protocol": "^0.1.0",
    "@dsh-a2ui/a2ui-renderer": "^0.1.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@dsh-a2ui/a2ui-adapter": "link:../a2ui-adapter",
    "@dsh-a2ui/a2ui-protocol": "link:../a2ui-protocol",
    "@dsh-a2ui/a2ui-renderer": "link:../a2ui-renderer",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  }
}
