{
  "name": "@dsh-plugin-edu/a2ui-catalog-example",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Example hot-pluggable A2UI catalog library",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client.tsx",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@dsh-plugin-edu/a2ui-renderer"],
      "platform": "web"
    }
  },
  "a2ui": {
    "catalog": {
      "id": "dsh-example",
      "components": ["notice"]
    },
    "host": "./lib/index.js",
    "client": "./lib/client.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5",
    "@dsh-plugin-edu/a2ui-adapter": "^0.1.0-beta.1",
    "@dsh-plugin-edu/a2ui-protocol": "^0.1.0-beta.1",
    "@dsh-plugin-edu/a2ui-renderer": "^0.1.0-beta.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@dsh-plugin-edu/a2ui-adapter": "link:../a2ui-adapter",
    "@dsh-plugin-edu/a2ui-protocol": "link:../a2ui-protocol",
    "@dsh-plugin-edu/a2ui-renderer": "link:../a2ui-renderer",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  }
}
