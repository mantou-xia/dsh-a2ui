{
  "name": "dsh-a2ui",
  "version": "0.1.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantou-xia/dsh-a2ui.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "oxlint packages",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "pack:dry-run": "pnpm -r --filter @dsh-a2ui/a2ui-protocol --filter @dsh-a2ui/a2ui-adapter --filter @dsh-a2ui/a2ui-renderer pack --dry-run",
    "release:check": "pnpm check && pnpm -r run build && pnpm run pack:dry-run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^18.3.31",
    "jsdom": "^30.0.1",
    "oxlint": "^1.73.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  }
}
